<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_32"
            android:background="@drawable/bg_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/dimension_24">

            <TextView
                android:id="@+id/emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_56" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_12"
                android:gravity="center"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_19"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_6"
                android:gravity="center"
                android:textColor="#5C5C6B"
                android:textSize="@dimen/text_size_14" />

            <RatingBar
                android:id="@+id/stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_16"
                android:numStars="5"
                android:progressTint="#FFB300"
                android:secondaryProgressTint="#FFB300"
                android:stepSize="1" />

            <TextView
                android:id="@+id/btnVote"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_48"
                android:layout_marginTop="@dimen/dimension_20"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="@string/rate"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNotNow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_44"
                android:layout_marginTop="@dimen/dimension_6"
                android:gravity="center"
                android:text="@string/not_now"
                android:textColor="#6750A4"
                android:textSize="@dimen/text_size_15" />
        </LinearLayout>
    </FrameLayout>
