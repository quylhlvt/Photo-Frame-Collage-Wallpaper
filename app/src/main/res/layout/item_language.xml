<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/itemRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_64"
        android:layout_marginVertical="@dimen/dimension_6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dimension_14">

        <TextView
            android:id="@+id/flag"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:background="@drawable/bg_circle_white"
            android:gravity="center"
            android:textSize="@dimen/text_size_22" />

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimension_14"
            android:layout_weight="1"
            android:textSize="@dimen/text_size_18" />

        <ImageView
            android:id="@+id/radio"
            android:layout_width="@dimen/dimension_26"
            android:layout_height="@dimen/dimension_26"
            android:contentDescription="@null" />
    </LinearLayout>
