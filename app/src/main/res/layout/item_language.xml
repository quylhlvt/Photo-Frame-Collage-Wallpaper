<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/itemRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_56"
        android:layout_marginTop="@dimen/dimension_4"
    android:layout_marginBottom="@dimen/dimension_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
    android:paddingHorizontal="@dimen/dimension_20"
        android:layout_marginHorizontal="@dimen/dimension_16">

        <ImageView
            android:id="@+id/flag"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:gravity="center"/>

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimension_16"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_18" />

        <ImageView
            android:id="@+id/radio"
            android:layout_width="@dimen/dimension_20"
            android:layout_height="@dimen/dimension_20"
            android:contentDescription="@null" />
    </LinearLayout>
