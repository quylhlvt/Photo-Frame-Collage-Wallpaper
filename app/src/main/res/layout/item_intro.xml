<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/title"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_10"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_30"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_18"
            android:fontFamily="@font/rowdies_regular"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_12"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_30"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/yellow2"
            android:textSize="@dimen/text_size_12" />
    </LinearLayout>
