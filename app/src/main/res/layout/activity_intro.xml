<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFBFF"
        android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_marginBottom="@dimen/dimension_20"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_16">
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:dotsColor="@color/gray2"
                app:dotsCornerRadius="@dimen/dimension_8"
                app:dotsSize="@dimen/dimension_8"
                app:dotsSpacing="@dimen/dimension_3"
                app:dotsWidthFactor="2.5"
                app:progressMode="false"
                app:selectedDotColor="@color/app_color"/>
        <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dimension_5"
                android:gravity="center"
                android:textColor="@color/app_color"
                android:text="@string/next"
                android:layout_gravity="end"
                android:fontFamily="@font/roboto_medium"
                android:textSize="@dimen/text_size_16"/>
    </FrameLayout>
</LinearLayout>
