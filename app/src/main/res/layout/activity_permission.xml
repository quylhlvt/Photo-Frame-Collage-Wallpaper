<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFBFF">

    <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/imv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dimension_100"
        android:contentDescription="@null"
        app:layout_constraintDimensionRatio="1.51:1.63"
        android:layout_marginBottom="@dimen/dimension_40"
        android:src="@drawable/img_ava_permission"
        app:layout_constraintBottom_toTopOf="@+id/permTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionBar" />

    <TextView
        android:id="@+id/permTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_6"
        android:layout_marginBottom="@dimen/dimension_18"
        android:gravity="center"
        android:paddingHorizontal="@dimen/dimension_16"
        android:textColor="@color/gray2"
        android:textSize="@dimen/text_size_14"
        app:layout_constraintBottom_toTopOf="@+id/rowPermission" />

    <!-- One row, filled in for the permission that applies (notifications on Android 13+, storage before). -->
    <RelativeLayout
        android:id="@+id/rowPermission"
        android:layout_width="match_parent"
        android:elevation="@dimen/dimension_2"
        android:layout_height="@dimen/dimension_56"
        android:layout_marginHorizontal="@dimen/dimension_16"
        android:layout_marginBottom="@dimen/dimension_100"
        android:background="@drawable/bg_language"
        app:layout_constraintBottom_toTopOf="@+id/btnContinue">

        <TextView
            android:id="@+id/permName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimension_24"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_regular"
            android:textSize="@dimen/text_size_18" />

        <ImageView
            android:id="@+id/permSwitch"
            android:layout_width="@dimen/dimension_56"
            android:layout_height="@dimen/dimension_25"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimension_20"
            android:contentDescription="@null"
            android:src="@drawable/switch_on" />
    </RelativeLayout>

    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimension_50"
        android:gravity="center"
        android:padding="@dimen/dimension_3"
        android:text="@string/continue_text"
        android:textColor="@color/app_color"
        android:textSize="@dimen/text_size_16"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
