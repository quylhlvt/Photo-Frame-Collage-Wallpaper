<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFBFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_20"
            android:gravity="center"
            android:text="@string/permission"
            android:textColor="#2B2B3A"
            android:textSize="@dimen/text_size_22"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/dimension_16"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_permission" />

        <TextView
            android:id="@+id/permTitle"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#2B2B3A"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permDesc"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_6"
            android:gravity="center"
            android:textColor="#5C5C6B"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/rowPermission"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_24"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dimension_16">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_allow"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_17" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_height="@dimen/dimension_56"
            android:layout_marginTop="@dimen/dimension_20"
            android:layout_marginBottom="@dimen/dimension_32"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:text="@string/continue_text"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />
    </LinearLayout>
