<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimension_16"
            android:paddingVertical="@dimen/dimension_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/diy"
                android:textSize="@dimen/text_size_22"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdd"
                android:layout_width="@dimen/dimension_40"
                android:layout_height="@dimen/dimension_40"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_plus"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_26" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dimension_12"
                android:paddingTop="@dimen/dimension_4"
                android:paddingBottom="@dimen/dimension_16" />
        </ScrollView>
    </LinearLayout>
