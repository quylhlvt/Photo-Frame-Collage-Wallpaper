<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimension_6">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hot_item"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="9:19.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="@dimen/dimension_36"
        android:layout_height="@dimen/dimension_36"
        android:layout_margin="@dimen/dimension_8"
        android:contentDescription="@null"
        android:padding="@dimen/dimension_4"
        android:src="@drawable/ic_more_dots"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />

    <ImageView
        android:id="@+id/btnCheck"
        android:layout_width="@dimen/dimension_36"
        android:layout_height="@dimen/dimension_36"
        android:layout_margin="@dimen/dimension_8"
        android:contentDescription="@null"
        android:padding="@dimen/dimension_5"
        android:src="@drawable/ic_check_off"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />
</androidx.constraintlayout.widget.ConstraintLayout>
