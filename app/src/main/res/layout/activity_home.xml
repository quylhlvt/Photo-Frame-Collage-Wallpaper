<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_64"
                android:paddingHorizontal="@dimen/dimension_16">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="@dimen/dimension_40"
                    android:layout_height="@dimen/dimension_40"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@null"
                    android:padding="@dimen/dimension_6"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/home_title"
                    android:textColor="#2B2B3A"
                    android:textSize="@dimen/text_size_22"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnAvatar"
                    android:layout_width="@dimen/dimension_40"
                    android:layout_height="@dimen/dimension_40"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_hot_item"
                    android:contentDescription="@null"
                    android:padding="@dimen/dimension_4"
                    android:src="@drawable/ic_card_polaroids" />
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dimension_16"
                    android:paddingBottom="@dimen/dimension_24">

                    <FrameLayout
                        android:id="@+id/cardStatic"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_150"
                        android:layout_marginTop="@dimen/dimension_8"
                        android:background="@drawable/bg_home_blue">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="@dimen/dimension_22"
                            android:layout_marginBottom="@dimen/dimension_36"
                            android:text="@string/home_diy"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_21"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/dimension_125"
                            android:layout_height="@dimen/dimension_110"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="@dimen/dimension_10"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_card_polaroids" />

                        <ImageView
                            android:layout_width="@dimen/dimension_46"
                            android:layout_height="@dimen/dimension_46"
                            android:layout_gravity="start|bottom"
                            android:layout_marginStart="@dimen/dimension_22"
                            android:layout_marginBottom="@dimen/dimension_14"
                            android:background="@drawable/bg_arrow_blue"
                            android:contentDescription="@null"
                            android:padding="@dimen/dimension_11"
                            android:src="@drawable/ic_arrow_right_white" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cardFrames"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_150"
                        android:layout_marginTop="@dimen/dimension_16"
                        android:background="@drawable/bg_home_orange">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="@dimen/dimension_22"
                            android:layout_marginBottom="@dimen/dimension_36"
                            android:text="@string/home_diy_live"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_21"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/dimension_125"
                            android:layout_height="@dimen/dimension_110"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="@dimen/dimension_10"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_card_polaroids" />

                        <ImageView
                            android:layout_width="@dimen/dimension_46"
                            android:layout_height="@dimen/dimension_46"
                            android:layout_gravity="start|bottom"
                            android:layout_marginStart="@dimen/dimension_22"
                            android:layout_marginBottom="@dimen/dimension_14"
                            android:background="@drawable/bg_arrow_orange"
                            android:contentDescription="@null"
                            android:padding="@dimen/dimension_11"
                            android:src="@drawable/ic_arrow_right_white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimension_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardVideo"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dimension_64"
                            android:layout_marginEnd="@dimen/dimension_8"
                            android:layout_weight="1"
                            android:background="@drawable/bg_small_card"
                            android:elevation="@dimen/dimension_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/dimension_12">

                            <ImageView
                                android:layout_width="@dimen/dimension_40"
                                android:layout_height="@dimen/dimension_40"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dynamic" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dimension_12"
                                android:text="@string/home_dynamic"
                                android:textColor="#2B2B3A"
                                android:textSize="@dimen/text_size_17"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardProject"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dimension_64"
                            android:layout_marginStart="@dimen/dimension_8"
                            android:layout_weight="1"
                            android:background="@drawable/bg_small_card"
                            android:elevation="@dimen/dimension_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/dimension_12">

                            <ImageView
                                android:layout_width="@dimen/dimension_40"
                                android:layout_height="@dimen/dimension_40"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_project" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dimension_12"
                                android:text="@string/home_project"
                                android:textColor="#2B2B3A"
                                android:textSize="@dimen/text_size_17"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimension_24">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_hot_viral"
                            android:textColor="#2B2B3A"
                            android:textSize="@dimen/text_size_20"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:text="@string/home_view_all"
                            android:textColor="#2F6FF0"
                            android:textSize="@dimen/text_size_14" />
                    </FrameLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimension_12"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/hotRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/dimension_300"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_drawer"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimension_20">

            <ImageView
                android:id="@+id/drawerLogo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_160"
                android:layout_marginTop="@dimen/dimension_56"
                android:contentDescription="@null"
                android:src="@drawable/ic_splash_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_12"
                android:layout_marginBottom="@dimen/dimension_20"
                android:gravity="center"
                android:text="@string/home_title"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold" />

            <LinearLayout android:id="@+id/itemLanguage" style="@style/DrawerItem">
                <ImageView style="@style/DrawerIcon" android:src="@drawable/ic_globe" />
                <TextView style="@style/DrawerText" android:text="@string/menu_language" />
                <ImageView style="@style/DrawerChevron" />
            </LinearLayout>

            <LinearLayout android:id="@+id/itemRate" style="@style/DrawerItem">
                <ImageView style="@style/DrawerIcon" android:src="@drawable/ic_star_white" />
                <TextView style="@style/DrawerText" android:text="@string/menu_rate" />
                <ImageView style="@style/DrawerChevron" />
            </LinearLayout>

            <LinearLayout android:id="@+id/itemShare" style="@style/DrawerItem">
                <ImageView style="@style/DrawerIcon" android:src="@drawable/ic_share_white" />
                <TextView style="@style/DrawerText" android:text="@string/menu_share" />
                <ImageView style="@style/DrawerChevron" />
            </LinearLayout>

            <LinearLayout android:id="@+id/itemPrivacy" style="@style/DrawerItem">
                <ImageView style="@style/DrawerIcon" android:src="@drawable/ic_shield_white" />
                <TextView style="@style/DrawerText" android:text="@string/menu_privacy" />
                <ImageView style="@style/DrawerChevron" />
            </LinearLayout>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>
