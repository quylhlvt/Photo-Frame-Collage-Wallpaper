<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimension_16"
        android:paddingVertical="@dimen/dimension_6">

        <LinearLayout
        android:id="@+id/menuDownload"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_48"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dimension_22"
                android:layout_height="@dimen/dimension_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_download_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimension_14"
                android:text="@string/project_download"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_1"
            android:background="#E6E6EE" />

        <LinearLayout
        android:id="@+id/menuSet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_48"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dimension_22"
                android:layout_height="@dimen/dimension_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_set_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimension_14"
                android:text="@string/project_set"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_1"
            android:background="#E6E6EE" />

        <LinearLayout
        android:id="@+id/menuDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_48"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dimension_22"
                android:layout_height="@dimen/dimension_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_trash_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimension_14"
                android:text="@string/project_delete"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>
    </LinearLayout>
