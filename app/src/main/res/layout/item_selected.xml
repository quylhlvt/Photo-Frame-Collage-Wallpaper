<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dimension_72"
    android:layout_height="@dimen/dimension_72">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimension_8"
        android:layout_marginEnd="@dimen/dimension_8"
        android:background="#EEF1F6"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/remove"
        android:layout_width="@dimen/dimension_20"
        android:layout_height="@dimen/dimension_20"
        android:layout_gravity="top|end"
        android:contentDescription="@null"
        android:src="@drawable/ic_close_blue" />
</FrameLayout>
