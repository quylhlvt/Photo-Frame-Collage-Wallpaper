<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <include
        android:id="@+id/actionBar"
        layout="@layout/layout_actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/dimension_8"
            android:paddingBottom="@dimen/dimension_16"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="@dimen/dimension_12"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimension_16"
        android:paddingTop="@dimen/dimension_16"
        android:paddingBottom="@dimen/dimension_16">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_32">

            <TextView
                android:id="@+id/tvSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:textColor="#2B2B3A"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnClearAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/bg_clear_all"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dimension_12"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/dimension_16"
                    android:layout_height="@dimen/dimension_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trash_clear" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimension_6"
                    android:text="@string/picker_clear_all"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_72"
            android:layout_marginTop="@dimen/dimension_12">

            <TextView
                android:id="@+id/tvNoneSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/picker_none_selected"
                android:textColor="#8A8A99"
                android:textSize="@dimen/text_size_12" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/selectedList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
