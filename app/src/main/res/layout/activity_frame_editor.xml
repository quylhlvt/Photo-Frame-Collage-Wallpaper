<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.example.depthwallpaper.frames.EditorViewModel" />

        <variable
            name="ui"
            type="com.example.depthwallpaper.frames.EditorActivity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            style="@style/HintText"
            android:text="@string/editor_hint" />

        <com.example.depthwallpaper.frames.FramePreviewView
            android:id="@+id/preview"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:layout_weight="1" />

        <TextView
            style="@style/HintText"
            android:gravity="start"
            android:text="@string/background" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPick"
                android:onClick="@{() -> ui.chooseAll()}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/choose_photos" />

            <Button
                android:id="@+id/btnReplace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="@{() -> ui.replaceSelected()}"
                android:text="@string/replace_photo"
                app:visible="@{vm.selected >= 0}" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:onClick="@{() -> ui.save()}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <Button
            android:id="@+id/btnSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> ui.setWallpaper()}"
            android:text="@string/set_wallpaper"
            app:visible="@{vm.canSet}" />
    </LinearLayout>
</layout>
