<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimension_32"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/dimension_16"
            android:background="@drawable/bg_blue_button"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dimension_14"
            android:text="@string/picker_next"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_12"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/dimension_24">

        <com.example.depthwallpaper.main.staticphoto.CollagePreviewView
            android:id="@+id/preview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="@dimen/dimension_12"
        android:orientation="vertical"
        android:paddingVertical="@dimen/dimension_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/picker_collage"
            android:textColor="#2B2B3A"
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_12"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dimension_16" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
