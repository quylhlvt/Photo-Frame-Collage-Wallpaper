<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dimension_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#5E9BFF"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/dimension_28"
            android:layout_height="@dimen/dimension_28"
            android:contentDescription="@null"
            android:src="@drawable/ic_add_image" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_6"
            android:text="@string/picker_add_image"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_14" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
