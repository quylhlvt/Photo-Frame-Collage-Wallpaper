<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.DepthWallpaper">

        <activity
            android:name=".home.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".staticphoto.CollageEditorActivity"
            android:exported="false" />
        <activity
            android:name=".frames.FrameListActivity"
            android:exported="false" />
        <activity
            android:name=".staticphoto.StaticActivity"
            android:exported="false" />
        <activity
            android:name=".video.VideoActivity"
            android:exported="false" />
        <activity
            android:name=".frames.EditorActivity"
            android:exported="false" />

        <service
            android:name=".service.DepthWallpaperService"
            android:exported="true"
            android:label="@string/image_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <service
            android:name=".service.VideoWallpaperService"
            android:exported="true"
            android:label="@string/video_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>

</manifest>
